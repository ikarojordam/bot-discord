# ═══════════════════════════════════════════════════════════
# FRIO BOT — Variáveis de ambiente
# ═══════════════════════════════════════════════════════════

# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=seu-bot-token
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=seu-id-do-discord
REDIRECT_URI=https://frio-bot.onrender.com/callback

# ─── Supabase (mesmas credenciais do painel) ────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....   # service_role

# ─── Integração com o painel ────────────────────────────────
# ⚠️ O PANEL_API_TOKEN DEVE SER O MESMO NOS DOIS PROJETOS
PANEL_API_TOKEN=cole-aqui-o-mesmo-token-do-painel
JWT_SECRET=cole-aqui-um-secret-aleatorio-longo

# ─── URLs ───────────────────────────────────────────────────
PANEL_URL=https://painel.seudominio.com
PORT=3000
WEBHOOK_PORT=3000

# ─── Mercado Pago (opcional, para pagamentos automáticos) ───
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_URL=https://frio-bot.onrender.com/api/mp/webhook

# ─── Render API (opcional, para métricas no painel) ─────────
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxx

# ─── Verificação ────────────────────────────────────────────
VERIFY_SECRET=outro-secret-aleatorio-longo
