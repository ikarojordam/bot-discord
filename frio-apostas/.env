# ═══════════════════════════════════════════════════════════
# FRIO APOSTAS — Configuração
# ═══════════════════════════════════════════════════════════

# Discord (APP NOVO — não é o mesmo do Frio Bot principal)
DISCORD_TOKEN=COLE_AQUI_O_TOKEN_DO_APP_NOVO
DISCORD_CLIENT_ID=COLE_AQUI_O_CLIENT_ID_DO_APP_NOVO
DISCORD_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET_DO_APP_NOVO

# Supabase (MESMO do Frio Bot principal)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# Dev
OWNER_ID=SEU_ID_DISCORD
PANEL_API_TOKEN=COLE_AQUI_O_MESMO_TOKEN_DO_PAINEL
JWT_SECRET=COLE_AQUI_O_MESMO_JWT_SECRET

# Web (porta diferente do Frio Bot principal)
PORT=3001
WEBHOOK_PORT=3001

# Render
RENDER_EXTERNAL_HOSTNAME=frio-apostas.onrender.com

# Channel ID onde o bot manda logs (opcional — se vazio, não loga)
LOG_CHANNEL_ID=

# Redirect (só se for usar verificação)
REDIRECT_URI=https://frio-apostas.onrender.com/callback
VERIFY_SECRET=COLE_AQUI_ALGO_ALEATORIO
