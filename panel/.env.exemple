# ═══════════════════════════════════════════════════════════
# FRIO PANEL — Variáveis de ambiente
# Copie para .env e preencha com seus valores
# ═══════════════════════════════════════════════════════════

# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=production
PORT=10000
# PANEL_PORT=10000                 # sobrescreve PORT (opcional)
PANEL_URL=https://painel.seudominio.com
# RENDER_EXTERNAL_HOSTNAME=        # preenchido automaticamente no Render

# ─── Supabase (obrigatórias) ────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....

# ─── Integração com o bot ───────────────────────────────────
BOT_API_URL=https://frio-bot.onrender.com
PANEL_API_TOKEN=cole-aqui-um-token-aleatorio-longo-com-32-caracteres-minimo

# ─── Discord (opcional no painel, mas recomendado) ──────────
# O painel usa esses para ações administrativas (OAuth guilds.join, leave, nuke, etc.)
DISCORD_TOKEN=seu-bot-token
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
